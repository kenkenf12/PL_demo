{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pl-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "FPL_SESSION", "class_name": "FplSession" },
      { "name": "ODDS_FEED", "class_name": "OddsFeed" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FplSession"] },
    { "tag": "v2", "new_sqlite_classes": ["OddsFeed"] }
  ]
}
